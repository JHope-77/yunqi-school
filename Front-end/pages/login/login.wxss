.login-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #2E6BFF 0%, #5B8CFF 60%, #8FB0FF 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx 0;
  box-sizing: border-box;
}
.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  color: #2E6BFF;
  font-size: 72rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.app-name { color: #FFFFFF; font-size: 44rpx; font-weight: 700; }
.slogan { color: rgba(255,255,255,0.85); font-size: 26rpx; margin-top: 12rpx; }

.form {
  width: 100%;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 36rpx;
  margin-top: 80rpx;
  box-sizing: border-box;
}
.avatar-picker { padding: 0; background: transparent; line-height: 0; margin-bottom: 32rpx; }
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #F0F2F7;
  margin: 0 auto;
}
.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #9AA3B5;
}
.nickname {
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}
.submit { margin: 0; }
.tip { color: rgba(255,255,255,0.75); font-size: 22rpx; margin-top: 40rpx; }
