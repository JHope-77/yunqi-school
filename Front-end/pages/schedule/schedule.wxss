.weekbar { white-space: nowrap; margin-bottom: 20rpx; }
.week {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  font-size: 24rpx;
  color: #6B7280;
  margin-right: 16rpx;
}
.week.on { background: #2E6BFF; color: #FFFFFF; font-weight: 600; }

.daybar {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}
.day { flex: 1; text-align: center; padding: 16rpx 0; font-size: 26rpx; color: #6B7280; border-radius: 16rpx; }
.day.on { background: #EEF3FF; color: #2E6BFF; font-weight: 700; }

.row { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.row:last-child { margin-bottom: 0; }
.sec-num { width: 72rpx; display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #6B7280; }
.course {
  flex: 1;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  color: #FFFFFF;
  min-height: 80rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.c-name { font-size: 26rpx; font-weight: 600; }
.c-meta { font-size: 20rpx; opacity: 0.9; margin-top: 4rpx; }
.c-empty { text-align: center; color: #C2C8D4; }
