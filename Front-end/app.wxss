page {
  background: #F5F7FA;
  color: #1A1D26;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.container { padding: 24rpx; box-sizing: border-box; }

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(30, 50, 100, 0.05);
}

.btn-primary {
  background: #2E6BFF;
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary[disabled] { background: #B8CCFF; color: #FFFFFF; }

.btn-green {
  background: #07C160;
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
  background: #EEF3FF;
  color: #2E6BFF;
}

.muted { color: #6B7280; font-size: 24rpx; }
.title { font-size: 32rpx; font-weight: 700; }
.price { color: #FF4D3D; font-weight: 700; }

.search-bar {
  background: #F0F2F7;
  border-radius: 36rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  color: #9AA3B5;
  font-size: 26rpx;
}
