.page { position: relative; width: 100%; height: 100vh; display: flex; flex-direction: column; }

.search-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  align-items: center;
}
.input {
  flex: 1;
  height: 72rpx;
  background: #F0F2F7;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}
.search-btn {
  background: #2E6BFF;
  color: #FFFFFF;
  font-size: 26rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}

.tabs {
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid #ECEEF2;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #6B7280;
}
.tab.on { color: #2E6BFF; font-weight: 700; border-bottom: 4rpx solid #2E6BFF; }

.map { flex: 1; width: 100%; }

.result-list {
  position: absolute;
  left: 24rpx; right: 24rpx;
  bottom: 40rpx;
  max-height: 480rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
}
.ri { padding: 20rpx 24rpx; border-bottom: 1rpx solid #F0F2F7; }
.ri:last-child { border-bottom: none; }
.rn { font-size: 28rpx; font-weight: 600; }
.ra { font-size: 22rpx; color: #6B7280; margin-top: 4rpx; }
